# Secrets and personal data — never commit these.
.env
# Leading slash anchors this to the repo root: the desktop app's runtime
# data/ (lookups.db, settings.json, register.html). WITHOUT the slash git
# matches a directory named "data" at ANY depth, which silently swallowed
# the Android app's whole com.harish.wordlookup.data source package —
# fourteen Kotlin files that were never committed and failed CI with
# "Unresolved reference 'data'".
/data/
*.pdf
*.db

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Build output (PyInstaller)
build/
dist/
*.spec

# Editors / OS / shortcuts
.vscode/
.idea/
*.lnk
*.log

# Android (android/) — keystore.properties and the .jks itself are the
# release signing secrets (see android/app/build.gradle.kts); CI supplies
# the same values from repo secrets instead, see .github/workflows/android.yml.
android/.gradle/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/**/.cxx/
android/captures/
android/**/*.iml
