# Secrets and personal data — never commit these.
.env
# Leading slash anchors this to the repo root (data/lookups.db,
# settings.json, register.html). Without it git matches a directory named
# "data" at ANY depth, silently swallowing anything else in the repo that
# happens to have one.
/data/
*.pdf
*.db

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Build output (PyInstaller)
build/
dist/
*.spec

# Editors / OS / shortcuts
.vscode/
.idea/
*.lnk
*.log
