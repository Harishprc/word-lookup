# Copy this file to .env and fill in your key. .env is gitignored — the
# key never lives in code or version control.

# --- Gemini (default provider, FREE) ------------------------------------
# Get a free key: https://aistudio.google.com -> "Get API key" -> create.
# No credit card, no GCP billing.
# Caveat: Google may use free-tier prompts to improve its models.
GEMINI_API_KEY=paste-your-key-here

# Translation backend: "gemini" (free, meaning + example sentence)
# or "google" (legacy Cloud Translation, needs GCP billing).
PROVIDER=gemini

# Default is gemini-flash-latest. The cheaper flash-lite has a higher
# daily quota but invents plausible-looking words in low-resource scripts
# (Kannada "restricted" came back as a pair of non-words), so accuracy
# wins by default. Swap it back if you do hundreds of lookups a day:
# GEMINI_MODEL=gemini-flash-lite-latest
#
# Also the escape hatch if Google ever retires the "-latest" alias (404 popup):
# GEMINI_MODEL=gemini-2.5-flash

# --- Google Cloud Translation (legacy fallback) --------------------------
# Only needed if PROVIDER=google. GCP console -> enable "Cloud Translation
# API" -> Credentials -> API key. First 500k chars/month free, then $20/M —
# but requires a billing card on file.
# GOOGLE_API_KEY=paste-your-key-here

# --- Optional overrides (defaults shown) ---------------------------------
# MAX_CHARS=500
# POPUP_TIMEOUT_MS=6000
# API_TIMEOUT_S=10

# --- Sync between machines (optional) -------------------------------------
# A GitHub personal access token with ONLY the "gist" scope:
# github.com/settings/tokens -> Generate new token (classic) -> check "gist".
# Shares this device's lookup cache with your other machines via one
# private Gist. Runs once at startup, in the background, and reports
# nothing. Unset = sync never runs; nothing else about the app changes.
# GITHUB_PAT=paste-your-token-here

# --- Shortcuts -----------------------------------------------------------
# Normally set in the first-run dialog or tray -> "Change shortcuts...",
# which saves them to data/settings.json. settings.json wins over these;
# the vars below are a fallback and keep v0.1.0 installs working.
# Both syntaxes are accepted: Qt ("Ctrl+Alt+G") and the old pynput form
# ("<ctrl>+<alt>+k").
#
# LOOKUP_HOTKEY is the keyboard trigger for a lookup — the alternative to
# the mouse Forward button, for laptops. Unset = mouse only.
# LOOKUP_HOTKEY=Ctrl+Alt+G
# TOGGLE_HOTKEY=<ctrl>+<alt>+k
