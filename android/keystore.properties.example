# Copy to keystore.properties (gitignored) for local release builds.
# Generate the keystore ONCE and keep it forever — re-signing with a new
# key breaks in-place updates on every device that already has the app
# installed. Same keystore.jks should be base64'd into the
# WORDLOOKUP_KEYSTORE_B64 repo secret so CI signs identically:
#
#   keytool -genkeypair -v -keystore release.jks -alias wordlookup \
#     -keyalg RSA -keysize 2048 -validity 10000
#   certutil -encode release.jks release.jks.b64   (Windows; strip header/footer lines)
#   # or: base64 -w0 release.jks > release.jks.b64  (macOS/Linux)

WORDLOOKUP_KEYSTORE_PATH=../release.jks
WORDLOOKUP_KEYSTORE_PASSWORD=paste-password-here
WORDLOOKUP_KEY_ALIAS=wordlookup
WORDLOOKUP_KEY_PASSWORD=paste-password-here
